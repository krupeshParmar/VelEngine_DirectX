<Window x:Class="VelEditor.GameDev.NewScriptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VelEditor.GameDev"
        mc:Ignorable="d"
        ResizeMode="NoResize" Style="{StaticResource VelDialogStyle}"
        WindowStartupLocation="CenterOwner"
        Title="New Script" Height="250" Width="400">
    <Border CornerRadius="3"
        Background="{StaticResource Editor.Window.GrayBrush3}"
        HorizontalAlignment="Stretch" Margin="10">
        <Grid Margin="32,0">
            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center"
                       Text="Enter script's name"
                   Foreground="{StaticResource Editor.FontBrush}"
                   Margin="0, 10, 0, 0" TextWrapping="Wrap" x:Name="messageTextBlock"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock Text="Script name" Width="72" Style="{StaticResource LightTextBoxStyle}"/>
                    <TextBox x:Name="scriptName" TextChanged="OnScriptName_TextBox_TextChanged"/>
                </DockPanel>
                <DockPanel Margin="0,5,0,0">
                    <TextBlock Text="Path" Width="72" Style="{StaticResource LightTextBoxStyle}"/>
                    <TextBox x:Name="scriptPath"/>
                </DockPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                    Margin="0,0,0,20" HorizontalAlignment="Right">
                <Button Content="Create" Width="64" IsDefault="True"
                    Click="OnCreateBtn_Click"/>
                <Button x:Name="cancelBtn" Content="Cancel" 
                Margin="10,0,0,0"  Width="64"
                IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
