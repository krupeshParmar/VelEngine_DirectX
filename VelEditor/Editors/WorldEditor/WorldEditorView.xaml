<UserControl x:Class="VelEditor.Editors.WorldEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VelEditor.Editors"
             xmlns:utl="clr-namespace:VelEditor.Utilities"
             xmlns:ctl="clr-namespace:VelEditor.Utilities.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             mc:Ignorable="d"
             Focusable="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Key="Z" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding RedoCommand}" Key="Y" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding SaveCommand}" Key="S" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding BuildCommand}" CommandParameter="{StaticResource True}" Key="F7"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Content="Undo"
                    Command="{Binding UndoCommand}"/>
            <Button Content="Redo"
                    Command="{Binding RedoCommand}" Margin="5,0"/>
            <Button Content="New Script"
                    Click="OnNewScript_Button_Clicked" Margin="5,0"
                    IsEnabled="{Binding Path=IsEnabled, ElementName=buildBtn}"/>
            <Button x:Name="buildBtn" Content="Build" Margin="10,0"
                    Command="{Binding BuildCommand}" CommandParameter="{StaticResource True}"/>
            <ComboBox x:Name="runConfig" VerticalAlignment="Center" Margin="10,0"
                      Width="72" SelectedIndex="{Binding BuildConfig}">
                <ComboBoxItem Content="Debug" IsSelected="True"/>
                <ComboBoxItem Content="Release"/>
            </ComboBox>
            <Button Content="Save"
                    Command="{Binding SaveCommand}" Margin="32,0,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="5,0,0,0" MinWidth="250">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <GridSplitter Grid.Row="1" Height="5" 
                          HorizontalAlignment="Stretch"
                              VerticalAlignment="Top" Background="Transparent"/>
                <local:ProjectLayoutView Background="{StaticResource Editor.Window.GrayBrush3}"/>
                <local:GameEntityInspecter Grid.Row="1"
                            Background="{StaticResource Editor.Window.GrayBrush3}"
                            Margin="0,5,0,0"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" 
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource Editor.Selected.BackgroundBrush}" Margin="2">
                    <StackPanel></StackPanel>
                </Border>
                <GridSplitter Grid.Row="1" Height="5" 
                          HorizontalAlignment="Stretch"
                              VerticalAlignment="Top" Background="Transparent"/>
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <utl:UndoRedoView DataContext="{Binding UndoRedoManager}" Grid.Column="0"
                                      Background="{StaticResource Editor.Window.GrayBrush2}"
                                      Margin="5,0,5,0"/>
                    <GridSplitter Grid.Column="1" Width="5" 
                          HorizontalAlignment="Left"
                            VerticalAlignment="Stretch" Background="Transparent"/>
                    <utl:LoggerView Grid.Column="1" Margin="5,0,0,0"/>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
