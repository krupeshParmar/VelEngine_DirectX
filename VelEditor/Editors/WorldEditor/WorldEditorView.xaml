<UserControl x:Class="VelEditor.Editors.WorldEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VelEditor.Editors"
             xmlns:utl="clr-namespace:VelEditor.Utilities"
             xmlns:ctl="clr-namespace:VelEditor.Utilities.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             xmlns:c="clr-namespace:VelEditor.Content"
             xmlns:gameproject="clr-namespace:VelEditor.GameProject" 
             d:DataContext="{d:DesignInstance Type=gameproject:Project}"
             mc:Ignorable="d"
             Focusable="True"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.Resources>
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="OnNewProject"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenProject"/>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnEditorClose"/>
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Key="Z" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding RedoCommand}" Key="Y" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding SaveCommand}" Key="S" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding DebugStartCommand}" Key="F5"/>
        <KeyBinding Command="{Binding DebugStartWithoutDebuggingCommand}" Key="F5" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding DebugStopCommand}" Key="F5" Modifiers="Shift"/>
        <KeyBinding Command="{Binding BuildCommand}" CommandParameter="{StaticResource True}" Key="F7"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="New Project..." Command="ApplicationCommands.New"/>
                <MenuItem Header="Open Project..." Command="ApplicationCommands.Open"/>
                <Separator/>
                <MenuItem Header="Save Project" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="Exit" Command="ApplicationCommands.Close"/>
            </MenuItem>
            <MenuItem Header="Settings"></MenuItem>
            <MenuItem Header="View"></MenuItem>
            <MenuItem Header="Create" IsEnabled="False"></MenuItem>
            <MenuItem Header="Window"></MenuItem>
        </Menu>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,10">
            <Button Content="Undo"
                Command="{Binding UndoCommand}"/>
            <Button Content="Redo"
                Command="{Binding RedoCommand}" Margin="5,0"/>
            <Button Content="New Script"
                Click="OnNewScript_Button_Clicked" Margin="5,0"
                IsEnabled="{Binding Path=IsEnabled, ElementName=buildBtn}"/>
            <Button x:Name="buildBtn" Content="Build" Margin="10,0"
                Command="{Binding BuildCommand}" CommandParameter="{StaticResource True}"/>
            <ComboBox x:Name="runConfig" VerticalAlignment="Center" Margin="10,0"
                  Width="72" SelectedIndex="{Binding BuildConfig}">
                <ComboBoxItem Content="Debug" IsSelected="True"/>
                <ComboBoxItem Content="Release"/>
            </ComboBox>
            <Button Content="Primitive Mesh" Click="OnCreatePrimitiveMesh_Button_Click" Margin="10,0"/>
            <Button Content="Save"
                Command="{Binding SaveCommand}" Margin="32,0,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <local:ProjectLayoutView Background="{StaticResource Editor.Window.GrayBrush3}" MinWidth="175" Margin="0,5,0,0"/>
                    <GridSplitter Grid.Column="1" Width="6" 
                      VerticalAlignment="Stretch"
                          HorizontalAlignment="Left" Background="Transparent"/>
                    <Grid Grid.Column="1" Margin="5,5,0,0">
                        <utl:RenderSurfaceView Margin="2"/>
                        <!--<Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="Transparent"
                                      VerticalAlignment="Stretch" HorizontalAlignment="Right" Width="5"/>
                        <GridSplitter Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Background="Transparent"
                                      VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="5"/>
                        <utl:RenderSurfaceView Grid.Row="0" Grid.Column="0" Margin="0,0,5,0"/>
                        <utl:RenderSurfaceView Grid.Row="0" Grid.Column="1" Margin="0,0,0,0"/>
                        <utl:RenderSurfaceView Grid.Row="1" Grid.Column="0" Margin="0,5,5,0"/>
                        <utl:RenderSurfaceView Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"/>-->
                    </Grid>
                </Grid>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent"/>
                <Grid Grid.Row="1" Margin="0,5,0,0" MinHeight="250">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <utl:UndoRedoView DataContext="{Binding UndoRedoManager}" Grid.Column="0"
                                  Background="{StaticResource Editor.Window.GrayBrush2}"
                                  Margin="0,0,0,0" MinWidth="175"/>
                    <GridSplitter Grid.Column="1" Width="5" 
                      HorizontalAlignment="Left"
                        VerticalAlignment="Stretch" Background="Transparent"/>
                    <utl:LoggerView Grid.Column="1" Margin="5,0,0,0" MinWidth="200"/>
                    <GridSplitter Grid.Column="2" Width="5" VerticalAlignment="Stretch"
                                  HorizontalAlignment="Left" Background="Transparent"/>
                    <c:ContentBrowserView Grid.Column="2" Margin="5,0,0,0" AllowImport="True" Loaded="OnContentBrowser_Loaded"
                                          IsVisibleChanged="OnContentBrowser_IsVisibleChanged"/>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" 
                      HorizontalAlignment="Left"
                        VerticalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="1" MinWidth="200">
                <local:GameEntityInspecter Grid.Row="1"
                        Background="{StaticResource Editor.Window.GrayBrush3}"
                        Margin="5,5,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
