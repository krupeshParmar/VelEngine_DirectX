<UserControl x:Class="VelEditor.Editors.GameEntityInspecter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VelEditor.Editors"
             xmlns:vm="clr-namespace:VelEditor.Components"
             mc:Ignorable="d" Background="{StaticResource Editor.Window.GrayBrush3}"
             d:DataContext="{d:DesignInstance Type=vm:MSEntity, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:NullableBoolToBoolConverter x:Key="nullableBoolToBoolConverter"/>
        <DataTemplate DataType="{x:Type vm:MSTransform}">
            <local:TransformComponentView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MSScript}">
            <local:ScriptComponentView/>
        </DataTemplate>
        <ContextMenu x:Key="addComponentMenu"
                     IsOpen="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ToggleButton}}}">
            <MenuItem Header="Physics">
                <MenuItem Header="Rigidbody"/>
                <MenuItem Header="BoxCollider"/>
                <MenuItem Header="CapsuleCollider"/>
                <MenuItem Header="CharacterController"/>
            </MenuItem>
            <MenuItem Header="MeshComponent"/>
            <MenuItem Header="Script" ItemsSource="{Binding SelectedEntities[0].ParentScene.Project.AvailableScripts}">
                <MenuItem.Style>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="5,3,2,3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedEntities[0].ParentScene.Project.AvailableScripts}">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="5,3,2,3"/>
                        <Setter Property="Header" Value="{Binding}"/>
                        <EventSetter Event="Click" Handler="OnAddScriptComponent"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="New Script" Click="OnAddNewScript_Menu_Clicked"/>
        </ContextMenu>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
                <Style.Triggers>
                    <Trigger Property="DataContext" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Style>
        <StackPanel Background="{StaticResource Editor.Window.GrayBrush4}" VerticalAlignment="Top">
            <Grid Margin="0,1" Background="{StaticResource Editor.Window.GrayBrush3}" SnapsToDevicePixels="True" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" Grid.Column="0" Margin="5,0,0,0" Style="{StaticResource LightTextBlockStyle}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=Explicit}" Grid.Column="1"
                         GotKeyboardFocus="OnName_TextBox_GotKeyboardFocus"
                         LostKeyboardFocus="OnName_TextBox_LostKeyboardFocus"
                         IsEnabled="{Binding IsEnabled, Converter={StaticResource nullableBoolToBoolConverter}}"/>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                          Click="OnIsEnabledCheckbox_Clicked"
                            Margin="5,0" VerticalAlignment="Center" Grid.Column="2"/>
            </Grid>
            <ItemsControl ItemsSource ="{Binding ComponentsList}" IsTabStop="False" SnapsToDevicePixels="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Height="32" Background="{StaticResource Editor.Window.GrayBrush3}">
                <ToggleButton x:Name="addComponent" ClickMode="Press" Focusable="False" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Margin="5,0,0,0"
                              PreviewMouseLeftButtonDown="OnAddComponent_Button_PreviewMouseLBD"
                              IsEnabled="{Binding IsEnabled, Converter={StaticResource nullableBoolToBoolConverter}}">
                    <ToggleButton.Content>
                        <DockPanel>
                            <TextBlock Text="Add Component" Margin="5,0"/>
                            <Path Margin="3,0,2,0"
                                Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4, 4 z"
                                  Fill="Black"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </DockPanel>
                    </ToggleButton.Content>
                </ToggleButton>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
