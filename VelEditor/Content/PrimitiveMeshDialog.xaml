<Window x:Class="VelEditor.Content.PrimitiveMeshDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VelEditor.Content"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:ctl="clr-namespace:VelEditor.Utilities.Controls"
        xmlns:edt="clr-namespace:VelEditor.Editors"
        mc:Ignorable="d" ResizeMode="NoResize"
        Foreground="{StaticResource Editor.FontBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Title="Create new Primitive Mesh" Height="450" Width="800"
        Style="{StaticResource VelDialogStyle}">
    <Window.DataContext>
        <edt:GeometryEditor/>
    </Window.DataContext>
    <Window.Resources>
        <ObjectDataProvider x:Key="dataFromEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:PrimitiveMeshType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style TargetType="{x:Type Label}">
            <Setter Property="Margin" Value="5,5,0,0"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource Editor.Window.GrayBrush2}">
        <Border Background="{StaticResource Editor.Window.GrayBrush3}" Height="32"
                DockPanel.Dock="Top" VerticalAlignment="Top" Margin="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ComboBox SelectedIndex="0" Width="100" VerticalAlignment="Center"
                          ItemsSource="{Binding Source={StaticResource dataFromEnum}}"
                          x:Name="primitiveTypeComboBox"
                          SelectionChanged="OnPrimitiveType_ComboBox_SelectionChanged"/>
                <CheckBox x:Name="textureCheckbox" Content="Texture" IsChecked="False"
                          Foreground="{StaticResource Editor.FontBrush}" VerticalAlignment="Center" Margin="5,0"
                          Click="OnTextureCheckbox_Clicked"/>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="100" MaxWidth="200" Width="69*"/>
                <ColumnDefinition Width="31*"/>
                <ColumnDefinition Width="300*"/>
            </Grid.ColumnDefinitions>
            <!-- Plane Settings -->
            <StackPanel Background="{StaticResource Editor.Window.GrayBrush3}" Grid.ColumnSpan="2">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=primitiveTypeComboBox}"
                                         Value="{x:Static local:PrimitiveMeshType.Plane}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Editor.Window.GrayBrush6}" Margin="5"
                            Background="{StaticResource Editor.Window.GrayBrush4}">
                        <StackPanel Margin="5,15,5,5">
                            <DockPanel Margin="5">
                                <TextBlock Text="Width" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Path=Value, ElementName=xSliderPlane}" Width="30" DockPanel.Dock="Right"/>
                                <Slider Minimum="1" Maximum="10" HorizontalAlignment="Stretch" TickFrequency="1" IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight" x:Name="xSliderPlane" ValueChanged="OnSlider_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5">
                                <TextBlock Text="Length" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Path=Value, ElementName=zSliderPlane}" Width="30" DockPanel.Dock="Right"/>
                                <Slider Minimum="1" Maximum="10" HorizontalAlignment="Stretch" TickFrequency="1" IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight" x:Name="zSliderPlane" ValueChanged="OnSlider_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Label Content="Segments" VerticalAlignment="Top"
                           HorizontalAlignment="Left" Padding="5,0" 
                           Foreground="{StaticResource Editor.FontBrush}"/>
                </Grid>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Editor.Window.GrayBrush6}" 
                            Margin="5" Background="{StaticResource Editor.Window.GrayBrush4}">
                        <StackPanel Margin="5,15,5,5">
                            <DockPanel Margin="5,5,5,0">
                                <TextBlock Text="Width" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <ctl:ScalarBox x:Name="widthScalarBoxPlane" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5,5,5,0">
                                <TextBlock Text="Length" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <ctl:ScalarBox x:Name="lengthScalarBoxPlane" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Label Content="Size" VerticalAlignment="Top"
                           HorizontalAlignment="Left" Padding="5,0" 
                           Foreground="{StaticResource Editor.FontBrush}"/>
                </Grid>
                <Button Content="Save Asset" Width="96" Margin="5,0" Click="OnSave_Button_Clicked"/>
            </StackPanel>
            <!-- Cube Settings -->
            <StackPanel Background="{StaticResource Editor.Window.GrayBrush3}" Grid.ColumnSpan="2">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=primitiveTypeComboBox}" Value="{x:Static local:PrimitiveMeshType.Cube}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Editor.Window.GrayBrush6}"
                            Margin="5">
                        <StackPanel Margin="5,15,5,5">
                            <DockPanel Margin="5">
                                <TextBlock Text="X" Width="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <Slider Minimum="1" Maximum="10" HorizontalAlignment="Stretch" TickFrequency="1" IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight" x:Name="xSliderCube" ValueChanged="OnSlider_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5">
                                <TextBlock Text="Y" Width="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <Slider Minimum="1" Maximum="10" HorizontalAlignment="Stretch" TickFrequency="1" IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight" x:Name="ySliderCube" ValueChanged="OnSlider_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5">
                                <TextBlock Text="Z" Width="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <Slider Minimum="1" Maximum="10" HorizontalAlignment="Stretch" TickFrequency="1" IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight" x:Name="zSliderCube" ValueChanged="OnSlider_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Label Content="Segments" Background="{StaticResource Editor.Window.GrayBrush3}" VerticalAlignment="Top"
                           HorizontalAlignment="Left"  Margin="20,-3,0,0" Padding="5,0" Foreground="{StaticResource Editor.FontBrush}"/>
                </Grid>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Editor.Window.GrayBrush6}"
                            Margin="5">
                        <StackPanel Margin="5,15,5,5">
                            <DockPanel Margin="5">
                                <TextBlock Text="X" Width="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <TextBox Text="1" x:Name="xTextBoxCube" TextChanged="OnTextBox_TextChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5,0">
                                <TextBlock Text="Y" Width="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <TextBox Text="1" x:Name="yTextBoxCube" TextChanged="OnTextBox_TextChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5">
                                <TextBlock Text="Z" Width="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <TextBox Text="1" x:Name="zTextBoxCube" TextChanged="OnTextBox_TextChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Label Content="Size" Background="{StaticResource Editor.Window.GrayBrush3}" VerticalAlignment="Top"
                           HorizontalAlignment="Left"  Margin="20,-3,0,0" Padding="5,0" Foreground="{StaticResource Editor.FontBrush}"/>
                </Grid>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Editor.Window.GrayBrush6}"
                            Margin="5">
                        <TextBox Text="1" Margin="30,20,10,10" x:Name="lodTextBoxCube" TextChanged="OnTextBox_TextChanged"/>
                    </Border>
                    <Label Content="LOD" Background="{StaticResource Editor.Window.GrayBrush3}" VerticalAlignment="Top"
                           HorizontalAlignment="Left"  Margin="20,-3,0,0" Padding="5,0" Foreground="{StaticResource Editor.FontBrush}"/>
                </Grid>
                <Button Content="Save" Click="OnSave_Button_Clicked" Width="80" Margin="5,0" VerticalAlignment="Bottom"/>
            </StackPanel>
            <!-- UVSphere Settings -->
            <StackPanel Background="{StaticResource Editor.Window.GrayBrush3}" Grid.ColumnSpan="2">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=primitiveTypeComboBox}"
                             Value="{x:Static local:PrimitiveMeshType.UVSphere}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Editor.Window.GrayBrush6}" Margin="5"
                Background="{StaticResource Editor.Window.GrayBrush4}">
                        <StackPanel Margin="5,15,5,5">
                            <DockPanel Margin="5">
                                <TextBlock Text="Lon." Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Path=Value, ElementName=xSliderUVSphere}" Width="30" DockPanel.Dock="Right"/>
                                <Slider Minimum="3" Maximum="64" Value="24" HorizontalAlignment="Stretch" Interval="1" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight" x:Name="xSliderUVSphere" ValueChanged="OnSlider_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5">
                                <TextBlock Text="Lat." Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Path=Value, ElementName=ySliderUVSphere}" Width="30" DockPanel.Dock="Right"/>
                                <Slider Minimum="2" Maximum="64" Value="12" HorizontalAlignment="Stretch" Interval="1" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight" x:Name="ySliderUVSphere" ValueChanged="OnSlider_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Label Content="Segments" VerticalAlignment="Top"
               HorizontalAlignment="Left" Padding="5,0" 
               Foreground="{StaticResource Editor.FontBrush}"/>
                </Grid>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Editor.Window.GrayBrush6}" 
                Margin="5" Background="{StaticResource Editor.Window.GrayBrush4}">
                        <StackPanel Margin="5,15,5,5">
                            <DockPanel Margin="5,5,5,0">
                                <TextBlock Text="X" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <ctl:ScalarBox x:Name="xScalarBoxUVSphere" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5,5,5,0">
                                <TextBlock Text="Y" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <ctl:ScalarBox x:Name="yScalarBoxUVSphere" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5,5,5,0">
                                <TextBlock Text="Z" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <ctl:ScalarBox x:Name="zScalarBoxUVSphere" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Label Content="Size" VerticalAlignment="Top"
               HorizontalAlignment="Left" Padding="5,0" 
               Foreground="{StaticResource Editor.FontBrush}"/>
                </Grid>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Editor.Window.GrayBrush6}" Margin="5"
                        Background="{StaticResource Editor.Window.GrayBrush4}">
                        <DockPanel Margin="5">
                            <TextBlock Text="Angle" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Path=Value, ElementName=angleSliderUVSphere}" Width="30" DockPanel.Dock="Right"/>
                            <Slider Minimum="0" Maximum="180" HorizontalAlignment="Stretch" TickFrequency="1" IsSnapToTickEnabled="True"
                                    x:Name="angleSliderUVSphere" ValueChanged="OnSlider_ValueChanged"/>
                        </DockPanel>
                    </Border>
                    <Label Content="Smoothing" VerticalAlignment="Top"
                        HorizontalAlignment="Left" Padding="5,0" 
                        Foreground="{StaticResource Editor.FontBrush}"/>
                </Grid>
                <Button Content="Save Asset" Width="96" Margin="5,0" Click="OnSave_Button_Clicked"/>
            </StackPanel>
            <!-- ICOSphere Settings -->
            <!-- Cylinder Settings -->
            <!-- Capsule Settings -->
            <edt:GeometryView DataContext="{Binding mMeshRenderer}" Grid.Column="2"/>
            <StackPanel Grid.Column="2"  Margin="5,5,0,0" Orientation="Vertical" VerticalAlignment="Top"
                            HorizontalAlignment="Left" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding mMeshRenderer.CameraPosition.X, StringFormat=G5}" Foreground="{StaticResource Editor.RedBrush}"/>
                    <TextBlock Text="{Binding mMeshRenderer.CameraPosition.Y, StringFormat=G5}" Foreground="{StaticResource Editor.GreenBrush}" Margin="10,0"/>
                    <TextBlock Text="{Binding mMeshRenderer.CameraPosition.Z, StringFormat=G5}" Foreground="{StaticResource Editor.BlueBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding mMeshRenderer.Meshes[0].Positions.Count}" Foreground="{StaticResource Editor.OrangeBrush}"/>
                    <TextBlock Text="{Binding mMeshRenderer.Meshes[0].Indices.Count}" Foreground="{StaticResource Editor.OrangeBrush}" Margin="10,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
