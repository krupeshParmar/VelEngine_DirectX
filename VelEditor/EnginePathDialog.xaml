<Window x:Class="VelEditor.EnginePathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VelEditor"
        mc:Ignorable="d" Style="{StaticResource VelDialogStyle}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Title="Where is Vel Engine?" Height="250" Width="400">
    <Border CornerRadius="3"
            Background="{StaticResource Editor.Window.GrayBrush3}"
            HorizontalAlignment="Stretch" Margin="10">
        <Grid Margin="32,0">
            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Center"
                       Foreground="{StaticResource Editor.RedBrush}"
                       Margin="0, 10, 0, 0" TextWrapping="Wrap" x:Name="messageTextBlock"/>
            <DockPanel>
                <TextBlock Text="Engine Path" Width="72" Style="{StaticResource LightTextBlockStyle}"/>
                <TextBox x:Name="pathTextBox"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                        Margin="0,0,0,20" HorizontalAlignment="Right">
                <Button Content="Ok" Width="64" IsDefault="True"
                        Click="OnOkBtn_Click"/>
                <Button x:Name="cancelBtn" Content="Cancel" 
                    Margin="10,0,0,0"  Width="64"
                    IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
